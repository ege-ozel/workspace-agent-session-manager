      "activitybar": [
        {
          "id": "workspaceAgentSessions",
          "title": "Agent Sessions",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "workspaceAgentSessions": [
        {
          "id": "workspaceAgentSessions.view",
          "name": "Usage",
          "icon": "images/activity.svg",
          "type": "webview",
          "when": "!workspaceAgentSessions.revealRepo"
        },
        {
          "id": "workspaceAgentSessions.projects",
          "name": "Projects",
          "icon": "images/activity.svg",
          "when": "!workspaceAgentSessions.revealRepo"
        }
      ],
      "explorer": [
        {
          "id": "workspaceAgentSessions.viewExplorer",
          "name": "Usage",
          "type": "webview",
          "icon": "images/activity.svg",
          "when": "workspaceAgentSessions.revealRepo"
        },
        {
          "id": "workspaceAgentSessions.projectsExplorer",
          "name": "Projects",
          "icon": "images/activity.svg",
          "when": "workspaceAgentSessions.revealRepo"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "workspaceAgentSessions.startSession",
          "when": "view =~ /^workspaceAgentSessions\\.projects/",
          "group": "navigation@0"
        },
        {
          "command": "workspaceAgentSessions.refresh",
          "when": "view =~ /^workspaceAgentSessions\\.view/",
          "group": "navigation"
        },
        {
          "command": "workspaceAgentSessions.refreshProjects",
          "when": "view =~ /^workspaceAgentSessions\\.projects/",
          "group": "navigation@2"
        },
        {
          "command": "workspaceAgentSessions.claudeLiveLimitsIsOn",
          "when": "view =~ /^workspaceAgentSessions\\.view/ && workspaceAgentSessions.liveLimits == on",
          "group": "navigation@1"
        },
        {
          "command": "workspaceAgentSessions.claudeLiveLimitsIsUnset",
          "when": "view =~ /^workspaceAgentSessions\\.view/ && workspaceAgentSessions.liveLimits == unset",
          "group": "navigation@1"
        },
        {
          "command": "workspaceAgentSessions.claudeLiveLimitsIsOff",
          "when": "view =~ /^workspaceAgentSessions\\.view/ && workspaceAgentSessions.liveLimits == off",
          "group": "navigation@1"
        },
        {
          "command": "workspaceAgentSessions.quickContext",
          "when": "view == terminal && workspaceAgentSessions.agentTerminal && workspaceAgentSessions.cmdContext",
          "group": "navigation@50"
        },
        {
          "command": "workspaceAgentSessions.quickUsage",
          "when": "view == terminal && workspaceAgentSessions.agentTerminal && workspaceAgentSessions.cmdUsage",
          "group": "navigation@51"
        },
        {
          "command": "workspaceAgentSessions.quickCompact",
          "when": "view == terminal && workspaceAgentSessions.agentTerminal && workspaceAgentSessions.cmdCompact",
          "group": "navigation@52"
        },
        {
          "command": "workspaceAgentSessions.quickModel",
          "when": "view == terminal && workspaceAgentSessions.agentTerminal && workspaceAgentSessions.cmdModel",
          "group": "navigation@53"
        },
        {
          "command": "workspaceAgentSessions.openActivePanel",
          "when": "view == terminal && workspaceAgentSessions.agentTerminal",
          "group": "navigation@49"
        },
        {
          "command": "workspaceAgentSessions.cycleMode",
          "when": "view == terminal && workspaceAgentSessions.agentTerminal",
          "group": "navigation@54"
        },
        {
          "command": "workspaceAgentSessions.agentCommands",
          "when": "view == terminal && workspaceAgentSessions.agentTerminal",
          "group": "navigation@55"
        },
        {
          "command": "workspaceAgentSessions.deleteSessions",
          "when": "view =~ /^workspaceAgentSessions\\.view/",
          "group": "navigation@2"
        },
        {
          "command": "workspaceAgentSessions.revealRepoIsOn",
          "group": "config@0.5",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && workspaceAgentSessions.revealRepo"
        },
        {
          "command": "workspaceAgentSessions.revealRepoIsOff",
          "group": "config@0.5",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && !workspaceAgentSessions.revealRepo"
        },
        {
          "command": "workspaceAgentSessions.restartAll",
          "group": "config@0",
          "when": "view =~ /^workspaceAgentSessions\\.projects/"
        },
        {
          "command": "workspaceAgentSessions.setDefaultAgent",
          "group": "navigation@1",
          "when": "view =~ /^workspaceAgentSessions\\.projects/"
        }
      ],
      "view/item/context": [
        {
          "command": "workspaceAgentSessions.openSessionPanel",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.panel\\./",
          "group": "inline@0"
        },
        {
          "command": "workspaceAgentSessions.openSessionPanel",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.panel\\./",
          "group": "session@0"
        },
        {
          "command": "workspaceAgentSessions.restartSession",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.close\\./",
          "group": "session@4.5"
        },
        {
          "command": "workspaceAgentSessions.newSession",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /^repo\\./",
          "group": "inline@1"
        },
        {
          "command": "workspaceAgentSessions.openInWindow",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /^repo\\./",
          "group": "inline@2"
        },
        {
          "command": "workspaceAgentSessions.resumeSession",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.resume\\./",
          "group": "inline@1"
        },
        {
          "command": "workspaceAgentSessions.closeSession",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.close\\./",
          "group": "inline@4"
        },
        {
          "command": "workspaceAgentSessions.archiveSession",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.archive\\./",
          "group": "inline@2"
        },
        {
          "command": "workspaceAgentSessions.unarchiveSession",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.unarchive\\./",
          "group": "inline@2"
        },
        {
          "command": "workspaceAgentSessions.deleteSession",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.delete\\./",
          "group": "inline@3"
        },
        {
          "command": "workspaceAgentSessions.agentCommands",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.close\\./",
          "group": "session@2"
        },
        {
          "command": "workspaceAgentSessions.rowContext",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.ctx\\./",
          "group": "inline@1"
        },
        {
          "command": "workspaceAgentSessions.rowCompact",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.compact\\./",
