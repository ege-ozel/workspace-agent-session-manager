          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.unarchive\\./",
          "group": "session@5"
        },
        {
          "command": "workspaceAgentSessions.deleteSession",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.delete\\./",
          "group": "session@6"
        },
        {
          "command": "workspaceAgentSessions.rowRename",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.rename\\./",
          "group": "inline@1.5"
        },
        {
          "command": "workspaceAgentSessions.rowRename",
          "group": "session@1",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /\\.rename\\./"
        }
      ],
      "commandPalette": [
        {
          "command": "workspaceAgentSessions.openSessionPanel",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.openActivePanel",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.claudeLiveLimitsIsOn",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.claudeLiveLimitsIsUnset",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.claudeLiveLimitsIsOff",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.quickContext",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.quickUsage",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.quickCompact",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.quickModel",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.sessionDetails",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.deleteSession",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.refreshProjects",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.newSession",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.openInWindow",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.resumeSession",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.closeSession",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.archiveSession",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.unarchiveSession",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.rowContext",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.rowCompact",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.rowModel",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.focusSession",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.newSessionMenu",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.quickRename",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.rowRename",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.moveRepoUp",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.moveRepoDown",
          "when": "false"
        },
        {
          "command": "workspaceAgentSessions.moveRepoToTop",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Workspace Agent Session Manager",
      "properties": {
        "workspaceAgentSessions.claudeContextWindows": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "default": {
            "claude-fable-5": 1000000,
            "claude-fable-5-1": 1000000,
            "claude-haiku-4-5": 200000,
            "claude-opus-4-6": 1000000,
            "claude-opus-4-7": 1000000,
            "claude-opus-4-8": 1000000,
            "claude-opus-5": 1000000,
            "claude-opus-5-5": 1000000,
            "claude-sonnet-4-6": 1000000,
            "claude-sonnet-5": 1000000,
            "claude-sonnet-5-5": 1000000
          },
          "markdownDescription": "Context window size (tokens) per Claude model id prefix. Claude Code does not record this per turn, so models not listed here show `—` for context (unless the model id ends in `[1m]`). Defaults come from Claude Code's own `/usage` reports."
        },
        "workspaceAgentSessions.claudeLimitsMaxAgeMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "Claude Code does not record 5h/weekly limits continuously. Older readings (from a /usage report or the status cache) are still shown, with a ~ and marked as possibly outdated, once they are older than this many minutes."
        },
        "workspaceAgentSessions.defaultAgent": {
          "type": "string",
          "default": "",
          "markdownDescription": "Agent id started directly by the **+** button on a repo in the Projects view, with that agent's own default model and effort (`claude`, `codex`, or the id of a registered provider). Empty asks which agent each time. The full menu stays on the row's right-click menu either way."
        },
        "workspaceAgentSessions.pollSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "description": "Fallback polling interval in seconds (file watching handles most updates)."
        },
        "workspaceAgentSessions.revealActiveRepo": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show the repo of the active agent terminal in the Explorer when you switch terminals. Focus goes straight back to the terminal."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run clean && npm run compile",
    "package": "vsce package",
    "test": "tsc -p . && node --test test/"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.93.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
