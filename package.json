{
  "name": "workspace-agent-session-manager",
  "displayName": "Workspace Agent Session Manager",
  "description": "Claude Code and OpenAI Codex sessions of every workspace folder in one place (start, resume, rename, archive, delete), with their context, 5-hour and weekly usage. Local files only: no network, no telemetry.",
  "version": "0.31.2",
  "publisher": "egeozel",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e2633",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ege-ozel/workspace-agent-session-manager"
  },
  "homepage": "https://github.com/ege-ozel/workspace-agent-session-manager#readme",
  "bugs": {
    "url": "https://github.com/ege-ozel/workspace-agent-session-manager/issues"
  },
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "codex",
    "openai",
    "ai",
    "agent",
    "usage",
    "rate limit",
    "limits",
    "quota",
    "context window",
    "tokens",
    "status bar",
    "sessions",
    "session manager"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "workspaceAgentSessions.revealRepoIsOn",
        "title": "✓ Explorer Follows Active Terminal",
        "category": "Agent Sessions"
      },
      {
        "command": "workspaceAgentSessions.revealRepoIsOff",
        "title": "Explorer Follows Active Terminal",
        "category": "Agent Sessions"
      },
      {
        "command": "workspaceAgentSessions.debugTerminals",
        "title": "Debug: List Terminals and Open Sessions",
        "category": "Agent Sessions"
      },
      {
        "command": "workspaceAgentSessions.restartSession",
