        "category": "Agent Sessions",
        "icon": "$(debug-restart)"
      },
      {
        "command": "workspaceAgentSessions.restartAll",
        "title": "Restart All Agent Terminals",
        "category": "Agent Sessions",
        "icon": "$(debug-restart)"
      },
      {
        "command": "workspaceAgentSessions.refresh",
        "title": "Refresh",
        "category": "Agent Sessions",
        "icon": "$(refresh)"
      },
      {
