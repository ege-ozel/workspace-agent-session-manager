          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /^psession/",
          "group": "session@1"
        },
        {
          "command": "workspaceAgentSessions.newSessionMenu",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /^repo\\./",
          "group": "0_new@1"
        },
        {
          "command": "workspaceAgentSessions.newSession",
          "when": "view =~ /^workspaceAgentSessions\\.projects/ && viewItem =~ /^repo\\./",
          "group": "0_new@2"
        },
